# Conexão com o banco de dados PostgreSQL
DATABASE_URL=postgresql+psycopg://leads:leads@localhost:5432/leads

# Diretório onde os ZIPs da Receita Federal serão baixados e extraídos
DATA_DIR=./data

# Nível de log: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# URL base dos dados abertos da Receita Federal
RF_BASE_URL=https://arquivos.receitafederal.gov.br/dados/cnpj/dados_abertos_cnpj
